---
import '../styles/site.css';
import { SITE, withBase } from '../lib/site';

const {
  title = SITE.title,
  description = SITE.description,
  ogImage = SITE.defaultOgImage,
  ogType = 'website',
  bodyClass = '',
  jsonLd = null,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(withBase(ogImage), Astro.site);

// Load Google Analytics only in production builds, and only if an ID is set.
const gaId = SITE.gaMeasurementId;
const enableAnalytics = Boolean(gaId) && import.meta.env.PROD;
// Exact standard gtag.js snippet (global `gtag`), rendered verbatim via set:html.
const gaInlineScript = `window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${gaId}');`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {
      enableAnalytics && (
        <Fragment>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
          <script is:inline set:html={gaInlineScript} />
        </Fragment>
      )
    }

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicons -->
    <link href={withBase('/assets/img/favicon.png')} rel="icon" />
    <link href={withBase('/assets/img/apple-touch-icon.png')} rel="apple-touch-icon" />

    <!-- Structured data (JSON-LD) -->
    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
  </head>

  <body class={bodyClass}>
    <header class="site-header site-wrap">
      <a class="site-skip" href="#main-content">Skip to content</a>
      <a class="site-wordmark" href={withBase('/')}>{SITE.name}</a>
      <nav aria-label="Main navigation">
        <a href={withBase('/#portfolio')}>Work</a>
        <a href={withBase(SITE.resume || '/#resume')}>Résumé</a>
        <a href={withBase('/lab/')}>Lab</a>
      </nav>
    </header>
    <main id="main-content"><slot /></main>
    <footer id="contact" class="site-footer site-wrap">
      <span>{SITE.name}</span>
      <nav aria-label="Contact links">
        <a href={`mailto:${SITE.email}`}>Email</a>
        <a href={SITE.socials.linkedin}>LinkedIn</a>
        <a href={SITE.socials.github}>GitHub</a>
      </nav>
    </footer>
  </body>
</html>
