---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { SITE } from '../lib/site';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

const filters = ['Projects', 'Research', 'Competitions', 'Coursework'];
---

<BaseLayout home={true} bodyClass="index-page">
  <!-- About Section -->
  <section id="about" class="about section">
    <div class="container section-title" data-aos="fade-up">
      <h2>About</h2>
      <p>{SITE.tagline}</p>
    </div>

    <div class="container" data-aos="fade-up" data-aos-delay="100">
      <div class="row gy-4 justify-content-center">
        <div class="col-lg-4">
          <img src="/assets/img/my-profile-img.jpg" class="img-fluid" alt="Victor Hu Profile" />
        </div>
        <div class="col-lg-8 content">
          <h2>From Mechanical Roots to Software Intelligence</h2>

          <p>
            I started my journey with a dual focus in <strong>Mechatronics</strong> and
            <strong>Computer Science</strong> because I wanted the capability to build a prototype from
            scratch, not just designing the mechanism, but also writing the control logic that brings it
            to life. This hands-on background allows me to debug issues where hardware and software
            intersect.
          </p>

          <div class="row">
            <div class="col-lg-6">
              <ul>
                <li>
                  <i class="bi bi-chevron-right"></i> <strong>Website:</strong>
                  <span><a href="https://vict0rhu.github.io" target="_blank">vict0rhu.github.io</a></span>
                </li>
                <li>
                  <i class="bi bi-chevron-right"></i> <strong>Focus:</strong>
                  <span>Simulation, Tooling, Integration</span>
                </li>
                <li>
                  <i class="bi bi-chevron-right"></i> <strong>GitHub:</strong>
                  <span><a href={SITE.socials.github} target="_blank">github.com/Vict0rHu</a></span>
                </li>
              </ul>
            </div>
            <div class="col-lg-6">
              <ul>
                <li>
                  <i class="bi bi-chevron-right"></i> <strong>Degree:</strong>
                  <span>M.S. in Robotics (Purdue)</span>
                </li>
                <li>
                  <i class="bi bi-chevron-right"></i> <strong>Email:</strong>
                  <span><a href={`mailto:${SITE.email}`}>{SITE.email}</a></span>
                </li>
                <li>
                  <i class="bi bi-chevron-right"></i> <strong>LinkedIn:</strong>
                  <span><a href={SITE.socials.linkedin} target="_blank">in/jyunchihu</a></span>
                </li>
              </ul>
            </div>
          </div>

          <p class="py-3">
            Currently at <strong>Purdue University</strong>, my focus has evolved from building
            individual robots to engineering the <strong>infrastructure</strong> that makes robotic
            development scalable. I enjoy creating internal tools, automating testing workflows, and
            validating algorithms in simulation before they touch real hardware.
          </p>

          <p>
            I am eager to bring this "full-stack" perspective, combining system-level thinking with
            software engineering rigor, to an internship role in <strong>Robotics Software</strong> or
            <strong>Infrastructure Tooling</strong> in 2026.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Skills Section -->
  <section id="skills" class="skills section light-background">
    <div class="container section-title" data-aos="fade-up">
      <h2>Technical Skills</h2>
    </div>

    <div class="container" data-aos="fade-up" data-aos-delay="100">
      <div class="row">
        <div class="col-lg-6 col-md-6 d-flex align-items-stretch mb-4">
          <div class="icon-box w-100">
            <h4><i class="bi bi-robot"></i> Robotics & Simulation</h4>
            <div class="mt-3">
              <span class="badge bg-dark me-1 mb-2 p-2">ROS2 (Nodes/Topics)</span>
              <span class="badge bg-dark me-1 mb-2 p-2">URDF/Xacro</span>
              <span class="badge bg-dark me-1 mb-2 p-2">RViz/Gazebo</span>
              <span class="badge bg-dark me-1 mb-2 p-2">Kinematics (FK/IK)</span>
              <span class="badge bg-dark me-1 mb-2 p-2">CoppeliaSim</span>
              <span class="badge bg-dark me-1 mb-2 p-2">Hardware Integration</span>
            </div>
          </div>
        </div>

        <div class="col-lg-6 col-md-6 d-flex align-items-stretch mb-4">
          <div class="icon-box w-100">
            <h4><i class="bi bi-eye"></i> AI & Computer Vision</h4>
            <div class="mt-3">
              <span class="badge bg-secondary me-1 mb-2 p-2">TensorFlow</span>
              <span class="badge bg-secondary me-1 mb-2 p-2">OpenCV</span>
              <span class="badge bg-secondary me-1 mb-2 p-2">Diffusion Policy</span>
              <span class="badge bg-secondary me-1 mb-2 p-2">Sensor Fusion</span>
              <span class="badge bg-secondary me-1 mb-2 p-2">Edge Inference</span>
            </div>
          </div>
        </div>

        <div class="col-lg-6 col-md-6 d-flex align-items-stretch mb-4">
          <div class="icon-box w-100">
            <h4><i class="bi bi-code-slash"></i> Languages & Tools</h4>
            <div class="mt-3">
              <span class="badge bg-primary me-1 mb-2 p-2">Python</span>
              <span class="badge bg-primary me-1 mb-2 p-2">Bash/Expect</span>
              <span class="badge bg-primary me-1 mb-2 p-2">Assembly Language</span>
              <span class="badge bg-primary me-1 mb-2 p-2">MATLAB</span>
              <span class="badge bg-primary me-1 mb-2 p-2">SQL</span>
              <span class="badge bg-primary me-1 mb-2 p-2">Git/GitHub</span>
              <span class="badge bg-primary me-1 mb-2 p-2">Linux/SSH</span>
            </div>
          </div>
        </div>

        <div class="col-lg-6 col-md-6 d-flex align-items-stretch mb-4">
          <div class="icon-box w-100">
            <h4><i class="bi bi-cpu"></i> Mechatronics & Hardware</h4>
            <div class="mt-3">
              <span class="badge bg-dark me-1 mb-2 p-2">Microcontroller (STM32)</span>
              <span class="badge bg-dark me-1 mb-2 p-2">AutoCAD</span>
              <span class="badge bg-dark me-1 mb-2 p-2">SolidWorks</span>
              <span class="badge bg-dark me-1 mb-2 p-2">Circuit Wiring</span>
              <span class="badge bg-dark me-1 mb-2 p-2">3D Printing</span>
              <span class="badge bg-dark me-1 mb-2 p-2">Rapid Prototyping</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Resume Section -->
  <section id="resume" class="resume section">
    <div class="container section-title" data-aos="fade-up">
      <h2>Resume</h2>
      <p>A comprehensive overview of my academic background and professional journey in robotics.</p>
    </div>

    <div class="container">
      <div class="row">
        <div class="col-lg-6" data-aos="fade-up" data-aos-delay="100">
          <h3 class="resume-title">Education</h3>

          <div class="resume-item">
            <h4><strong>Master of Science in Engineering - Robotics</strong></h4>
            <h5>2025 - 2027 (Expected)</h5>
            <p><em>Purdue University, West Lafayette, IN</em></p>
            <p><strong>GPA:</strong> 4.0/4.0</p>
            <p>
              Specializing in ROS2 infrastructure and sensor fusion. My goal is to master the
              integration of software intelligence with hardware reality.
            </p>
            <p>
              <strong>Key Coursework:</strong> Robotic Systems (ROS2), Industrial Robotics (Sim), Deep
              Learning for CV, Microprocessors (STM32).
            </p>
          </div>

          <div class="resume-item">
            <h4><strong>BE in Mechatronic Engineering, Minor in CS</strong></h4>
            <h5>2020 - 2025</h5>
            <p><em>National Taiwan Normal University, Taipei, Taiwan</em></p>
            <p><strong>GPA:</strong> 3.71/4.0</p>
            <p>
              Driven by the desire to <strong>"build any prototype from scratch,"</strong> I pursued a
              dual focus in Mechatronics (for mechanical/electrical foundations) and Computer Science
              (for algorithmic control), enabling me to bridge the gap between hardware and software.
            </p>
            <p>
              <strong>Key Coursework:</strong> Automatic Control, Mechanism Design, Data Structures,
              Algorithms, System Programming, Image Processing.
            </p>
          </div>

          <div class="resume-item">
            <h4><strong>International Exchange Student</strong></h4>
            <h5>2024 - 2025</h5>
            <p><em>University of Nevada, Reno, NV</em></p>
            <p>
              Broadened global perspective and adapted to the US educational system while taking
              advanced engineering electives.
            </p>
          </div>

          <div class="resume-item">
            <h4><strong>Interdisciplinary Program in Finance</strong></h4>
            <h5>2020 - 2025</h5>
            <p><em>National Taiwan Normal University</em></p>
            <p>
              Gained insights into economics and financial analysis to understand the market impact of
              technological developments.
            </p>
          </div>
        </div>

        <div class="col-lg-6" data-aos="fade-up" data-aos-delay="200">
          <h3 class="resume-title">Professional Experience</h3>

          <div class="resume-item">
            <h4><strong>Quality Assurance Intern</strong></h4>
            <h5>Feb 2025 - July 2025</h5>
            <p><em>FLUX Inc., Taipei, Taiwan</em></p>
            <ul>
              <li>
                <strong>Internal Tooling:</strong> Engineered a hybrid automation suite using
                <strong>Python</strong> and <strong>Bash/Expect</strong> for automated SSH execution,
                eliminating manual entry errors.
              </li>
              <li>
                <strong>Efficiency:</strong> Reduced test setup time by <strong>~95%</strong> (from 100s
                to &lt;5s) and accelerated firmware regression workflows.
              </li>
              <li>
                <strong>QA Process:</strong> Executed regression test suites and designed new test cases
                to ensure firmware release quality.
              </li>
            </ul>
          </div>

          <div class="resume-item">
            <h4><strong>Electronic Control Intern</strong></h4>
            <h5>Jul 2023 - Aug 2023</h5>
            <p><em>Skytech Inc., Hsinchu, Taiwan</em></p>
            <ul>
              <li>
                Assembled, wired, and tested electrical control systems, ensuring reliability in
                semiconductor equipment.
              </li>
              <li>
                Conducted on-site troubleshooting of signal wiring and I/O modules, strengthening
                system-level debugging skills.
              </li>
            </ul>
          </div>

          <div class="resume-item">
            <h4><strong>Research Assistant</strong></h4>
            <h5>Feb 2023 - Jun 2023</h5>
            <p><em>National Taiwan Normal University, Taipei, Taiwan</em></p>
            <ul>
              <li>
                Applied <strong>Taguchi methods</strong> to identify high-impact experimental factors,
                then designed an end-to-end pipeline for data collection, preprocessing, and
                <strong>MLP-based prediction</strong>.
              </li>
              <li>Presented research findings at the <strong>2023 ARIS International Conference</strong>.</li>
            </ul>
          </div>

          <div class="resume-item">
            <h4><strong>Teaching Assistant</strong></h4>
            <h5>Feb 2023 - Jun 2023</h5>
            <p><em>National Taiwan Normal University, Taipei, Taiwan</em></p>
            <ul>
              <li>
                Taught electronics experiments using <strong>NI ELVIS II</strong> and
                <strong>LabVIEW</strong> for data acquisition and analysis.
              </li>
              <li>Guided students through circuit simulations (Multisim) and hardware debugging sessions.</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Portfolio Section -->
  <section id="portfolio" class="portfolio section light-background">
    <div class="container section-title" data-aos="fade-up">
      <h2>Portfolio</h2>
    </div>

    <div class="container">
      <ul class="portfolio-filters" data-aos="fade-up" data-aos-delay="100">
        <li data-filter="*" class="filter-active">All</li>
        {filters.map((f) => <li data-filter={`.filter-${f.toLowerCase()}`}>{f}</li>)}
      </ul>

      <div class="row gy-4 portfolio-container" data-aos="fade-up" data-aos-delay="200">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Lightweight category filter (replaces the old Isotope dependency).
  const filterBtns = document.querySelectorAll<HTMLElement>('.portfolio-filters li');
  const items = document.querySelectorAll<HTMLElement>('.portfolio-container .portfolio-item');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelector('.portfolio-filters .filter-active')?.classList.remove('filter-active');
      btn.classList.add('filter-active');

      const filter = btn.dataset.filter ?? '*';
      const cls = filter.replace('.', '');
      items.forEach((item) => {
        const show = filter === '*' || item.classList.contains(cls);
        item.classList.toggle('portfolio-hidden', !show);
      });
    });
  });
</script>
