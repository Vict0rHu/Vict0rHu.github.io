---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { NEWS, SITE, personStructuredData, withBase } from '../lib/site';
import ProjectTile from '../components/ProjectTile.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const selected = [
  {
    id: 'visuotactile-diffusion-policy',
    title: 'CONTACT',
    context: 'Purdue MARS Lab · IROS 2026',
    summary: 'We taught a Franka Panda to take objects apart and tested how tactile force fields changed what it could do.',
    image: '/assets/img/portfolio/visuotactile-diffusion-policy/cover.jpg',
    alt: 'CONTACT experiment and tactile sensing overview',
    diagram: true,
  },
  {
    id: 'aoi-ai-inspection',
    title: 'Automated optical inspection',
    context: 'NTNU · 2024–25',
    summary: 'I led the build of a machine that uses polarized light to estimate residual stress in transparent samples.',
    image: '/assets/img/portfolio/aoi-ai-inspection/cover.jpg',
    alt: 'The optical inspection machine at Intelligent Asia, with a sample tray and an inspection screen',
  },
  {
    id: 'fpv-ptz-teleoperation',
    title: 'Egocentric teleoperation',
    context: 'Purdue · 2025',
    summary: 'I linked a Quest 3 to a moving camera and a Franka arm, so the operator could look around the workbench in VR.',
    image: '/assets/img/portfolio/fpv-ptz-teleoperation/headset-view.jpg',
    alt: 'The Franka Panda and its workspace as seen through the Quest 3 headset',
  },
];

const archive = projects.filter(project => !selected.some(work => work.id === project.id));
const person = personStructuredData(Astro.site!);
const profile = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: SITE.name, url: person.url },
    { '@type': 'ProfilePage', url: person.url, mainEntity: person, primaryImageOfPage: person.image },
  ],
};
---

<BaseLayout bodyClass="homepage" jsonLd={profile} ogImage={SITE.profileImage}>
  <section id="about" class="home-intro site-wrap" aria-labelledby="hero">
    <h1 id="hero">{SITE.name}</h1>
    <p>I’m a robotics master’s student at Purdue and a research associate at AMD. I work on how robots use cameras and touch to handle objects. I publish as {SITE.publicationName}.</p>
    <div class="home-intro-links">
      <a class="home-primary" href="#portfolio">Selected work <span aria-hidden="true">↓</span></a>
      <a href={SITE.socials.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section id="portfolio" class="home-section site-wrap" aria-labelledby="home-work-title">
    <h2 id="home-work-title">Selected work</h2>
    <div class="project-grid">
      {selected.map(work => <ProjectTile {...work} />)}
    </div>
    <details class="home-disclosure">
      <summary>All projects</summary>
      <div class="project-grid project-grid-archive">
        {archive.map(({ id, data }) => (
          <ProjectTile
            id={id}
            title={data.title}
            context={[data.date, data.filter].filter(Boolean).join(' · ')}
            image={data.thumbnail}
          />
        ))}
      </div>
    </details>
  </section>

  <div class="site-wrap home-background">
    <section id="resume" class="home-section home-experience" aria-labelledby="home-experience-title">
      <h2 id="home-experience-title">Experience</h2>
      <div class="home-role">
        <div><h3>AMD</h3><p>Research Associate</p></div>
        <span class="site-meta">Aug 2026 – present</span>
        <p class="home-role-description">I explore how robot learning and tactile sensing run on AMD hardware, including real-time workloads at the edge.</p>
      </div>
      <div class="home-role">
        <div><h3>Factory Intelligence</h3><p>AI &amp; Robotics Intern</p></div>
        <span class="site-meta">May–Aug 2026</span>
        <p class="home-role-description">Built data and training pipelines for robot imitation learning on industrial manipulation tasks.</p>
      </div>
      <details class="home-disclosure">
        <summary>Earlier experience</summary>
        <ul class="home-archive">
          <li>
            <span>FLUX Inc. · QA Intern</span><span>Feb–Jul 2025</span>
            <p>Designed and ran firmware regression tests. Automated SSH test setup with Python and Bash/Expect, cutting setup time from about 100 seconds to under 5.</p>
          </li>
          <li>
            <span>Skytech Inc. · Electronic Control Intern</span><span>Jul–Aug 2023</span>
            <p>Assembled and tested control systems for semiconductor equipment and debugged wiring and I/O on site.</p>
          </li>
          <li>
            <span>NTNU · Research Assistant</span><span>Feb–Jun 2023</span>
            <p>Used Taguchi methods and an MLP to study manufacturing quality. Presented the work at ARIS 2023.</p>
          </li>
        </ul>
      </details>
    </section>

    <section id="news" class="home-section" aria-labelledby="home-news-title">
      <h2 id="home-news-title">Recent updates</h2>
      <ul class="home-updates">
        {NEWS.map(item => (
          <li>
            <span class="site-meta">{item.date}</span>
            {item.url ? <a href={item.url.startsWith('http') ? item.url : withBase(item.url)}>{item.text} <span aria-hidden="true">↗</span></a> : <span>{item.text}</span>}
          </li>
        ))}
      </ul>
    </section>
  </div>

  <section id="education" class="home-section site-wrap" aria-labelledby="home-education-title">
    <h2 id="home-education-title">Education</h2>
    <div class="home-education-grid">
      <div class="home-role">
        <div><h3>Purdue University</h3><p>M.S. in Robotics</p></div>
        <span class="site-meta">2025–2027 (expected)</span>
      </div>
      <div class="home-role">
        <div><h3>National Taiwan Normal University</h3><p>B.E. in Mechatronic Engineering, CS minor</p></div>
        <span class="site-meta">2020–2025</span>
      </div>
      <div class="home-role">
        <div><h3>University of Nevada, Reno</h3><p>Exchange student</p></div>
        <span class="site-meta">2024–2025</span>
      </div>
    </div>
    <details class="home-disclosure">
      <summary>Coursework and GPA</summary>
      <ul class="home-archive">
        <li><strong>Purdue</strong><p>GPA 4.0/4.0. Robotic systems, industrial robotics, computer vision and microprocessors.</p></li>
        <li><strong>NTNU</strong><p>GPA 3.71/4.0. Control, mechanism design, systems programming and image processing.</p></li>
      </ul>
    </details>
  </section>

  <section class="home-section site-wrap home-lab" aria-labelledby="home-lab-title">
    <div>
      <h2 id="home-lab-title">Interactive Lab</h2>
      <p>Drive a small robot around my room and step into recreations of my experiments.</p>
      <a href={withBase('/lab/')}>Explore the Lab <span aria-hidden="true">↗</span></a>
      <small>Early access</small>
    </div>
    <a class="home-lab-image" href={withBase('/lab/')} aria-label="Open the interactive Lab">
      <img src={withBase('/assets/img/lab-contact-preview.webp')} width="1510" height="857" alt="The CONTACT memory in the interactive Lab, with a Franka Panda arm, camera feeds, and the visitor robot" loading="lazy" />
    </a>
  </section>
</BaseLayout>
