---
import { getEntry } from 'astro:content';
import { SITE, withBase } from '../lib/site';
import { CONTACT_ID, memoryScenes, objects, travelDestinations } from '../lab/content';
import '../lab/lab.css';
import { posterWallCopy } from '../lab/poster-wall-content';
import { unrGraduationPhoto } from '../lab/unr-content';
import { awardDisplays } from '../lab/awards-content';

const awards = await Promise.all(awardDisplays.map(async ({ project, work, results }) => {
  const { data } = await getEntry('projects', project);
  if (!data.labAward) throw new Error(`Missing Lab award details: ${project}`);
  return { ...data.labAward, year: data.date, role: data.role, results: data.highlights.slice(0, results), work };
}));
const projectUrl = withBase(`/portfolio/${CONTACT_ID}/`);
const home = withBase('/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Explore Victor Hu’s workbench and robotics memories as a small visiting robot." />
    <title>Robotics Lab — Victor Hu</title>
  </head>
  <body>
    <main class="lab-shell" id="lab" data-scene="room">
      <header class="lab-header">
        <div class="lab-scene-heading">
          <a id="lab-home" class="lab-home" href={home}><span aria-hidden="true">←</span> Victor Hu</a>
          <button id="lab-scene-exit" class="lab-inspection-close" type="button" aria-label="Return to Victor’s room" aria-keyshortcuts="Escape" hidden>ESC</button>
          <div class="lab-heading">
            <p class="lab-eyebrow" id="lab-scene-label" hidden></p>
            <h1 id="scene-title">Victor’s room</h1>
          </div>
        </div>
        <div class="lab-header-links">
          <nav aria-label="Portfolio links">
            <a href={`${home}#portfolio`}>Projects</a>
            <a href={SITE.resume ? withBase(SITE.resume) : `${home}#resume`}>Résumé</a>
          </nav>
          <p class="lab-clock" id="lab-clock" hidden><span class="clock-dot"></span><span id="lab-time"></span> <span class="clock-zone">Denver</span></p>
        </div>
      </header>
      <section class="lab-stage" aria-label="Scene">
        <div id="lab-world" class="lab-world" hidden>
          <canvas id="lab-canvas" aria-label="3D room" tabindex="0"></canvas>
          <div id="lab-markers" class="lab-markers"></div>
          <div id="lab-portal-guide" class="lab-portal-guide" role="img" aria-label="Direction to the travel circle" hidden>
            <span aria-hidden="true">➜</span>
          </div>
          <p id="lab-thought" class="lab-thought" role="status" hidden></p>
        </div>
        <div id="lab-unavailable" class="lab-unavailable" role="status" hidden>
          <p>3D is unavailable in this browser.</p>
          <a class="lab-button" href={projectUrl}>Read the CONTACT case study</a>
        </div>
        <noscript><div class="lab-unavailable"><a class="lab-button" href={projectUrl}>Read the CONTACT case study</a></div></noscript>
        <div id="lab-panel" class="lab-panel" role="region" aria-labelledby="lab-panel-title" hidden>
          <div class="lab-panel-header">
            <h2 id="lab-panel-title" tabindex="-1"></h2>
            <button id="lab-close" class="lab-inspection-close" aria-label="Close inspection" aria-keyshortcuts="Escape Space" type="button">ESC</button>
          </div>
          <p id="lab-panel-description" aria-live="polite"></p>
          <pre id="lab-terminal" aria-label="Simulated terminal output" hidden></pre>
          <button id="lab-action" type="button" class="lab-button lab-button-primary" aria-keyshortcuts="Enter" hidden>
            <span id="lab-action-label"></span><kbd aria-hidden="true">↵</kbd>
          </button>
          {Object.entries(memoryScenes).map(([id, memory]) => (
            <a data-memory-project={id} class="lab-case-study" href={withBase(`/portfolio/${memory.project}/`)} hidden>{id === 'unr' ? 'More about the exchange' : 'Read the project'} <span aria-hidden="true">↗</span></a>
          ))}
        </div>
        <section id="lab-poster-browser" class="lab-poster-browser" role="dialog" aria-modal="true" aria-label="Memory posters" tabindex="-1" hidden>
          <button data-poster-close class="lab-inspection-close" type="button" aria-label="Leave the poster wall" aria-keyshortcuts="Escape">ESC</button>
          <div class="lab-poster-choice">
            <p data-poster-status class="lab-poster-count"></p>
            <h2 data-poster-title aria-live="polite"></h2>
            <div class="lab-poster-navigation">
              <button data-poster-step="-1" class="lab-button" type="button" aria-label="Previous poster">←</button>
              <button data-poster-enter class="lab-button lab-button-primary" type="button" aria-keyshortcuts="Enter"><span>{posterWallCopy.enter}</span><kbd aria-hidden="true">↵</kbd></button>
              <button data-poster-step="1" class="lab-button" type="button" aria-label="Next poster">→</button>
            </div>
          </div>
        </section>
        <section id="lab-awards-browser" class="lab-awards-browser" role="dialog" aria-modal="true" aria-label="Awards display" tabindex="-1" hidden>
          <button data-award-close class="lab-inspection-close" type="button" aria-label="Back from award details or leave the display" aria-keyshortcuts="Escape">ESC</button>
          <div id="lab-award-details" class="lab-award-details" data-award-details hidden>
            {awards.map(award => (
              <article data-award-record data-title={award.name} data-year={award.year} hidden>
                <p class="lab-award-issuer">{award.issuer}</p>
                <h3>Recognition</h3>
                <ul>{award.results.map(result => <li>{result}</li>)}</ul>
                <h3>My part <span>· {award.role}</span></h3>
                <p>{award.contribution}</p>
                <a href={withBase(`/portfolio/${award.work}/`)} target="_blank" rel="noopener noreferrer">View the work <span aria-hidden="true">↗</span></a>
              </article>
            ))}
          </div>
          <div class="lab-award-choice">
            <p class="lab-poster-count"><span data-award-count></span><span aria-hidden="true"> · </span><span data-award-year></span></p>
            <h2 data-award-title aria-live="polite"></h2>
            <div class="lab-poster-navigation">
              <button data-award-step="-1" class="lab-button" type="button" aria-label="Previous award">←</button>
              <button data-award-toggle class="lab-button lab-button-primary" type="button" aria-controls="lab-award-details" aria-expanded="false" aria-keyshortcuts="Enter"><span>View details</span><kbd aria-hidden="true">↵</kbd></button>
              <button data-award-step="1" class="lab-button" type="button" aria-label="Next award">→</button>
            </div>
          </div>
        </section>
      </section>
      <footer class="lab-controls">
        <div class="lab-move" id="lab-move" hidden>
          <div class="lab-dpad" id="lab-dpad" role="group" aria-label="Move robot">
            <button type="button" data-move="up" aria-label="Move up">↑</button>
            <button type="button" data-move="left" aria-label="Move left">←</button>
            <button type="button" data-move="down" aria-label="Move down">↓</button>
            <button type="button" data-move="right" aria-label="Move right">→</button>
          </div>
        </div>
        <div class="lab-controls-actions">
          <div id="lab-preview" class="lab-preview" hidden>
            <label for="lab-preview-time">Test time <output id="lab-preview-value" for="lab-preview-time"></output></label>
            <input id="lab-preview-time" type="range" min="0" max="1439" step="1" />
            <select id="lab-preview-day" aria-label="Test day">
              <option value="live">Live Denver</option>
              <option value="weekday">Weekday</option>
              <option value="weekend">Weekend</option>
            </select>
          </div>
        </div>
      </footer>
      <div id="lab-scene-veil" class="lab-scene-veil" aria-hidden="true" hidden></div>
      <dialog id="lab-photo-viewer" class="lab-photo-viewer" aria-labelledby="lab-photo-title">
        <header class="lab-photo-header">
          <div><span class="lab-photo-mode">▹ PLAYBACK</span><h2 id="lab-photo-title">{unrGraduationPhoto.title}</h2></div>
          <button class="lab-inspection-close" type="button" aria-label="Close graduation photo" aria-keyshortcuts="Escape Enter Space">ESC</button>
        </header>
        <figure class="lab-photo-screen">
          <img width="1600" height="1200" data-src={withBase(unrGraduationPhoto.src)} alt={unrGraduationPhoto.alt} />
          <span class="lab-photo-frame" aria-hidden="true"></span>
          <span class="lab-photo-number" aria-hidden="true">01 / 01</span>
        </figure>
        <footer class="lab-photo-footer"><p>{unrGraduationPhoto.reply}</p><span>{unrGraduationPhoto.location}</span></footer>
      </dialog>
      <dialog id="lab-travel" class="lab-travel" aria-labelledby="lab-travel-title">
        <form method="dialog">
          <button class="lab-close" aria-label="Close destinations" value="cancel">×</button>
          <h2 id="lab-travel-title" tabindex="-1">Where to?</h2>
          <div class="lab-destinations">
            {travelDestinations.map(({ id, name, detail }) => (
              <button type="submit" value={id} data-destination={id} class="lab-destination">
                <span>{name}</span>
                <small>{detail}</small>
                <span class="destination-state" aria-hidden="true">→</span>
              </button>
            ))}
          </div>
        </form>
      </dialog>
      <template id="lab-objects">
        {Object.entries(objects).map(([id, object]) => (
          <button type="button" class="lab-hotspot" data-object={id}>
            <span class="hotspot-dot" aria-hidden="true"></span><span class="hotspot-label">{object.label}</span><kbd class="hotspot-enter" aria-hidden="true">↵</kbd>
          </button>
        ))}
      </template>
    </main>
    <script>
      import '../lab/controller';
    </script>
  </body>
</html>
