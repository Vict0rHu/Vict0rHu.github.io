---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { personStructuredData, withBase } from '../../lib/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const d = project.data;
const { Content } = await render(project);

// Fall back to the thumbnail if no media is supplied.
const media =
  d.media.length > 0 ? d.media : [{ type: 'image' as const, src: d.thumbnail, alt: d.title }];

const isMp4 = (src: string) => /\.mp4($|\?)/i.test(src);
const ogImage = media.find((m) => m.type === 'image')?.src ?? d.thumbnail;

// CreativeWork structured data for this project, authored by the shared Person.
const projectLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: d.title,
  headline: d.title,
  description: d.description,
  image: new URL(withBase(ogImage), Astro.site).href,
  url: new URL(withBase(`/portfolio/${project.id}/`), Astro.site).href,
  author: personStructuredData(Astro.site!),
  ...(d.category ? { genre: d.category } : {}),
  ...(d.tech.length > 0 ? { keywords: d.tech.join(', ') } : {}),
};

const firstMedia = media[0];
const moreMedia = media.slice(1);
---

<BaseLayout
  title={`${d.title} · Victor Hu`}
  description={d.description}
  ogImage={ogImage}
  ogType="article"
  bodyClass="project-page"
  jsonLd={projectLd}
>
  <article class="site-wrap case-study">
    <header class="case-header">
      <a class="case-back" href={withBase('/#portfolio')}>← Back to work</a>
      <h1>{d.title}</h1>
      <p>{d.description}</p>
    </header>

    <div class="case-grid">
      <div class="case-feature">
        {firstMedia.type === 'image' ? (
          <img src={withBase(firstMedia.src)} alt={firstMedia.alt ?? d.title} fetchpriority="high" />
        ) : isMp4(firstMedia.src) ? (
          <video controls preload="metadata" src={withBase(firstMedia.src)} aria-label={firstMedia.alt ?? d.title} />
        ) : (
          <iframe src={firstMedia.src} title={firstMedia.alt ?? d.title} allowfullscreen loading="lazy" />
        )}
      </div>

      <aside class="case-info" aria-label="Project details">
        <dl>
          {d.role && <div><dt>Role</dt><dd>{d.role}</dd></div>}
          {d.date && <div><dt>Date</dt><dd>{d.date}</dd></div>}
          {d.category && <div><dt>Area</dt><dd>{d.category}</dd></div>}
          {d.tech.length > 0 && <div><dt>Tools</dt><dd>{d.tech.join(' · ')}</dd></div>}
        </dl>
        {d.links.length > 0 && (
          <ul class="case-links">
            {d.links.map(link => <li><a href={link.url}>{link.label} <span aria-hidden="true">↗</span></a></li>)}
          </ul>
        )}
      </aside>

      <div class="case-copy">
        <Content />
        {d.highlights.length > 0 && (
          <details class="home-disclosure">
            <summary>Project highlights</summary>
            <ul>{d.highlights.map(highlight => <li>{highlight}</li>)}</ul>
          </details>
        )}
      </div>
    </div>

    {moreMedia.length > 0 && (
      <section class="case-media" aria-labelledby="case-media-title">
        <h2 id="case-media-title">Project media</h2>
        <div class="case-media-grid">
          {moreMedia.map(m => (
            <figure>
              {m.type === 'image' ? (
                <img src={withBase(m.src)} alt={m.alt ?? d.title} loading="lazy" />
              ) : isMp4(m.src) ? (
                <video controls preload="none" src={withBase(m.src)} aria-label={m.alt ?? d.title} />
              ) : (
                <iframe src={m.src} title={m.alt ?? d.title} allowfullscreen loading="lazy" />
              )}
              {m.alt && <figcaption>{m.alt}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
