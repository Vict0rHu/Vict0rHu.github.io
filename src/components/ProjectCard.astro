---
import { withBase } from '../lib/site';

const { project } = Astro.props;
const d = project.data;
const filterClass = `filter-${d.filter.toLowerCase()}`;
const thumb = withBase(d.thumbnail);
const detailUrl = withBase(`/portfolio/${project.id}/`);
---

<div class={`col-lg-4 col-md-6 portfolio-item ${filterClass}`}>
  <div class="portfolio-content h-100">
    <img src={thumb} class="img-fluid" alt={d.title} loading="lazy" />
    <div class="portfolio-info">
      <h4>{d.title}</h4>
      <p>{d.description}</p>
      <a
        href={thumb}
        title={d.title}
        data-gallery={`portfolio-gallery-${d.filter}`}
        class="glightbox preview-link"
        aria-label={`Preview ${d.title}`}><i class="bi bi-zoom-in"></i></a
      >
      <a href={detailUrl} title="More Details" class="details-link" aria-label={`Details for ${d.title}`}
        ><i class="bi bi-link-45deg"></i></a
      >
    </div>
  </div>
</div>
