---
import { withBase } from '../lib/site';

const { project } = Astro.props;
const d = project.data;
const filterClass = `filter-${d.filter.toLowerCase()}`;
const thumb = withBase(d.thumbnail);
const detailUrl = withBase(`/portfolio/${project.id}/`);
---

<div class={`col-lg-4 col-md-6 portfolio-item ${filterClass}`}>
  <a href={detailUrl} class="portfolio-content h-100" aria-label={`View ${d.title}`}>
    <img src={thumb} class="img-fluid" alt={d.title} loading="lazy" />
    <div class="portfolio-info">
      <h4>{d.title}</h4>
      <p>{d.description}</p>
      <span class="details-link" aria-hidden="true"><i class="bi bi-arrow-right-circle"></i></span>
    </div>
  </a>
</div>
